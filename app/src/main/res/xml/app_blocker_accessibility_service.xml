<?xml version="1.0" encoding="utf-8"?>
<!--
    The event set is intentionally narrow: we only need to know when a new
    window comes to the foreground so we can read its package name. The exact
    set may be adjusted after testing on the target device (see spec §13.2).
-->
<accessibility-service
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:accessibilityEventTypes="typeWindowStateChanged"
    android:accessibilityFeedbackType="feedbackGeneric"
    android:notificationTimeout="100"
    android:canRetrieveWindowContent="false"
    android:description="@string/accessibility_service_description" />
